# =============================================================================
# 台股智能分析系統 — 環境變數範本 (.env.example)
# =============================================================================
# 用法：cp .env.example .env，再依實機填值。所有變數皆有程式碼預設值；
#       此處預設對應反向整理自 172.16.9.166 (ming-ai02) 的實機三節點拓撲。
#       標【祕密】者請務必自填，切勿提交至版控（.env 已在 .gitignore）。
#
# 說明欄格式：預設值 | 必填/選填/祕密 | 用途
# 本檔僅列「程式碼實際以 os.getenv 讀取」的變數；不含已淘汰的 NestJS 時代設定。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. MongoDB
# -----------------------------------------------------------------------------
# 主連線 URI。實機預設 27017（注意：非舊版文件誤植的 27018）。
MONGODB_URI=mongodb://localhost:27017          # 必填 | 全系統資料存取
# 資料庫名稱（部分 scripts 讀取；預設 tw_stock_analysis）。
MONGODB_DATABASE=tw_stock_analysis             # 選填 | DB 名


# -----------------------------------------------------------------------------
# 2. Ollama 推理節點 URL（三節點拓撲）
# -----------------------------------------------------------------------------
# 主力推理節點 .28（技術/基本面/總經/風控等重推理角色）。
OLLAMA_URL=http://172.16.9.28:11434            # 必填 | 主力推理 .28
# 合議 / 換視角節點 .27（value/chip 角色 + 委員會投票）。
OLLAMA_CONSENSUS_URL=http://172.16.9.27:11434  # 必填 | 合議 .27
# Facilitator 綜合定案節點；留空則回退為 OLLAMA_URL(.28)。
OLLAMA_FACILITATOR_URL=                        # 選填 | facilitator，空=用 .28
# 額外推理節點（altos）；留空=停用。
OLLAMA_ALTOS_URL=                              # 選填 | 額外節點，空=停用
# RAG / 國際新聞摘要用節點（預設 .27）。
RAG_OLLAMA_URL=http://172.16.9.27:11434        # 選填 | RAG/國際新聞


# -----------------------------------------------------------------------------
# 3. LLM 模型 / 角色映射
# -----------------------------------------------------------------------------
# 台股主力 14b（investment-advisor / orchestrator / fundamental / macro 等）。
TWSTOCK_MAIN_LLM=qwen3-14b:latest              # 選填 | 主力模型
# 換視角模型（value-analyst / chip-analyst 角色）。
TWSTOCK_VIEW_LLM=gemma2:9b                      # 選填 | 換視角模型
# 技術角色模型（2026-08 分流至 .27 的 llama3.1:8b；設 qwen3-14b:latest 可還原）。
TECH_MODEL=llama3.1:8b                          # 選填 | technical-analyst
# 風控角色模型。
RISK_MODEL=qwen2.5-14b:latest                  # 選填 | risk-manager
# 合議委員模型清單（逗號分隔）。
CONSENSUS_MODELS=gemma2:9b,qwen2.5-14b:latest,llama3.1:8b   # 選填 | 委員會
# 合議 facilitator（綜合定案）模型。
CONSENSUS_FACILITATOR=qwen3-14b:latest         # 選填 | facilitator 模型
# Devil's advocate：1=啟用，0=停用。
CONSENSUS_DEVIL=0                              # 選填 | 反方委員開關
CONSENSUS_DEVIL_MODEL=qwen2.5-14b:latest       # 選填 | 反方委員模型
# 合議模式（部分 scripts 讀取）。
CONSENSUS_MODE=                                # 選填 | 合議模式旗標


# -----------------------------------------------------------------------------
# 4. LLM 取樣 / 重試參數
# -----------------------------------------------------------------------------
# 0 = greedy 完全可重現；調高可增多樣性。
LLM_TEMPERATURE=0                             # 選填 | 取樣溫度
LLM_SEED=42                                   # 選填 | 隨機種子（可重現）
CONSENSUS_NUM_CTX=8192                         # 選填 | 合議 context 長度
ROLE_NUM_CTX=8192                             # 選填 | 角色 context 長度
CONSENSUS_RETRY=3                             # 選填 | 合議重試次數
ROLE_RETRY=3                                  # 選填 | 角色重試次數


# -----------------------------------------------------------------------------
# 5. 資料來源 API 金鑰
# -----------------------------------------------------------------------------
# FinMind 主要 token（多數 downloaders / analysis 讀取此名）。
FINMIND_API_TOKEN=                            #【祕密】必填 | FinMind API
# ⚠️ 命名不一致：少數 scripts 讀 FINMIND_TOKEN。兩者建議設為相同值，
#    待後續重構統一為單一名稱後可移除此別名。
FINMIND_TOKEN=                                #【祕密】選填 | FinMind 別名（部分 scripts）


# -----------------------------------------------------------------------------
# 6. LINE 通知
# -----------------------------------------------------------------------------
LINE_CHANNEL_ID=                              #【祕密】選填 | LINE Messaging API
LINE_CHANNEL_SECRET=                          #【祕密】選填 | LINE channel secret
LINE_CHANNEL_ACCESS_TOKEN=                    #【祕密】選填 | LINE access token
LINE_USER_ID=                                 #【祕密】選填 | 推播對象 user id
LINE_NOTIFY_TOKEN=                            #【祕密】選填 | LINE Notify token
# 離線暫存路徑：LINE 送不出時把訊息暫存於此檔。
LINE_SPOOL=                                   # 選填 | 離線 spool 檔路徑


# -----------------------------------------------------------------------------
# 7. 團隊 / 排程 / 品質調校（scripts 用；未設則採程式碼內建預設）
# -----------------------------------------------------------------------------
# 核心池動能過濾百分比。
CORE_POOL_MOM_FILTER_PCT=0.30                  # 選填 | core_pool 動能門檻
# Ollama↔規則 一致率低於此值時，verdict_ab_eval --persist 寫排程警報。
VERDICT_AGREEMENT_ALERT_THRESHOLD=0.6          # 選填 | 一致率告警門檻(0~1)
# 1=一致率告警同時發 LINE(需上方 LINE_* 已設)；空/0=僅寫 schedule_alerts。
VERDICT_ALERT_LINE=                            # 選填 | 一致率告警是否發 LINE
# 1=啟用 Google 新聞來源，0=停用。
NEWS_GOOGLE=1                                 # 選填 | Google 新聞開關
# 角色失敗容忍上限。
ROLE_FAIL_MAX=                                # 選填 | 角色失敗上限
# 團隊分析：總經快取 / 容忍零資料天數 / 角色並行度。
TEAM_MACRO_CACHE=                             # 選填 | 總經快取
TEAM_MAX_ZERO_DAYS=                           # 選填 | 容忍零資料天數
TEAM_ROLE_PARALLEL=                           # 選填 | 角色並行度
# 品質 A/B：目標年化。
QUAL_TARGET_ANNUAL=                           # 選填 | 品質目標年化
# 重建配額控制（backfill / rebuild 節流）。
REBUILD_MAX_QUOTA_RETRY=                       # 選填 | 重建配額重試上限
REBUILD_MIN_INTERVAL=                          # 選填 | 重建最小間隔
REBUILD_QUOTA_SLEEP=                           # 選填 | 配額耗盡休眠秒數
# 排程健康檢查 / 產出延遲告警。
HEALTHCHECK_URL=                              # 選填 | healthcheck ping URL
OUTPUT_MAX_LAG=                               # 選填 | 產出最大容許延遲
