[Unit]
Description=tw-stock quarterly_earnings_sync（cron→systemd 遷移,Persistent 補跑）
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/mdsadmin/Stock/tw-stock-analysis
# 保留原 cron 指令(含 >> logs 重導),行為等價
ExecStart=/usr/bin/bash -c '/bin/bash scripts/quarterly_earnings_sync.sh >> /home/mdsadmin/Stock/tw-stock-analysis/logs/cron_quarterly_earnings_sync.log 2>&1'
