[Unit]
Description=tw-stock data_health_weekly_finmind（cron→systemd 遷移,Persistent 補跑）
After=network-online.target mongod.service
Wants=network-online.target
OnFailure=tw-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/mdsadmin/Stock/tw-stock-analysis
# 保留原 cron 指令(含 >> logs 重導),行為等價
ExecStart=/usr/bin/bash -c '/home/mdsadmin/Stock/.venv/bin/python3 scripts/data_health.py --finmind 30 >> /home/mdsadmin/Stock/tw-stock-analysis/logs/cron_data_health.log 2>&1'
