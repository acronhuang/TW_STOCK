# 統一行尾:文字檔一律 LF,避免 Windows/Linux 混用造成 CRLF 污染
* text=auto eol=lf

# 明確指定常見文字類型為 LF
*.py    text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.toml  text eol=lf

# 二進位檔:不做行尾轉換
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.pkl   binary
*.parquet binary
